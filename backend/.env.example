# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real credentials.

PORT=5000

# MongoDB Atlas connection string (Database → Connect → Drivers → Node.js in
# the Atlas dashboard). Put the real database name ("scanwise") before the
# "?" in the path, e.g.:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/scanwise?retryWrites=true&w=majority&appName=Cluster0
#
# Troubleshooting: if you see "tlsv1 alert internal error" / "SSL alert
# number 80" connecting from Windows, it's a known Node.js/network issue
# where some of the cluster's 3 replica servers aren't reachable over TLS
# from your network - it's not a code bug. Fastest fixes, in order:
#   1. Recreate the Atlas cluster (Database → Clusters → ... → Terminate,
#      then create a new M0 cluster) - a fresh cluster gets different
#      underlying server IPs, which usually resolves it.
#   2. Try a different network/VPN.
#   3. As a last resort, connect directly to whichever single shard host IS
#      reachable (test each with `openssl s_client -connect <host>:27017`)
#      using the standard mongodb:// scheme instead of mongodb+srv://, e.g.:
#      mongodb://<user>:<password>@<one-working-shard-host>:27017/scanwise?directConnection=true&tls=true&retryWrites=true&w=majority&authSource=admin
#      Note: that host must currently be the PRIMARY (not a secondary) or
#      writes will fail with "not primary" - check Atlas's cluster overview,
#      or just try each host in turn.
MONGODB_URI=

# Any long random string - used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Email delivery ──────────────────────────────────────────────────────────
# Powers the HR/manager "Email shortlisted candidates" composer.
#
# Leave everything below blank and the app falls back to the `console` driver:
# messages are logged by the server and never delivered. The composer says so,
# in as many words, so a demo is never mistaken for a real send.
#
# MAIL_DRIVER   resend | smtp | console.
#               Optional - leave blank and the first configured one wins
#               (RESEND_API_KEY → resend, else SMTP_HOST → smtp, else console).
MAIL_DRIVER=

# The From: header. Must be an address on a domain your provider has verified,
# or the provider will reject the message. Display name is optional:
#   Screenwise Hiring <hiring@yourdomain.com>
MAIL_FROM=

# ── Option A: Resend (recommended) ──────────────────────────────────────────
# Plain HTTPS, so no SMTP ports to be blocked by a host or an ISP. Free tier
# covers 3,000 emails/month, 100/day.
#   1. Sign up at https://resend.com
#   2. Domains → Add Domain, then add the DNS records it shows you (once
#      verified, set MAIL_FROM to an address on that domain).
#   3. API Keys → Create API Key (Sending access) → paste it below.
# To try it before you own a domain, leave MAIL_FROM as the default
# "Screenwise <onboarding@resend.dev>" - Resend accepts that sender but will
# only deliver to the email address that owns the Resend account.
RESEND_API_KEY=

# ── Option B: SMTP (Gmail / Workspace, Amazon SES, Office 365, Mailtrap …) ──
# Fill these instead of RESEND_API_KEY.
# Gmail/Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER is the
# full address, and SMTP_PASS must be a 16-character App Password from
# https://myaccount.google.com/apppasswords (2-Step Verification required -
# your normal account password will not work).
# Mailtrap: use the inbox's credentials to catch every message in a test inbox
# instead of delivering it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional - defaults to true only on port 465 (implicit TLS).
SMTP_SECURE=

# Optional - minimum milliseconds between provider calls in a bulk send.
# Defaults to 550 on Resend (its free tier allows 2 requests/second) and 0 on
# SMTP. Raise it if your provider rate-limits a large shortlist.
MAIL_THROTTLE_MS=
